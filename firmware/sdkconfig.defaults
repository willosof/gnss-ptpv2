CONFIG_IDF_TARGET="esp32p4"

# EMAC PPS output requires ESP32-P4 silicon v3.x (IDF default minimum is v3.1).

# Internal EMAC + IP101GRI PHY (Waveshare ESP32-P4-ETH / ESP32-P4-NANO wiring)
CONFIG_ETHERNET_INTERNAL_SUPPORT=y
CONFIG_ETHERNET_PHY_IP101=y

CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_FREERTOS_HZ=1000
CONFIG_LWIP_IGMP=y

# ptp_net transmits from its own task alongside lwIP
CONFIG_ETH_TRANSMIT_MUTEX=y
